            "value": "En yüksek çözünürlük"
          }
        }
      }
    },
    "Best available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut en iyi"
          }
        }
      }
    },
    "Audio only (M4A)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
