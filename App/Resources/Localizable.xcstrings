          }
        }
      }
    },
    "Default: MP4 at up to 1080p. Streams are merged with the bundled ffmpeg.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan: en fazla 1080p MP4. Akışlar gömülü ffmpeg ile birleştirilir."
          }
        }
      }
    },
    "Custom yt-dlp -f expression (overrides the pickers)": {
      "localizations": {
