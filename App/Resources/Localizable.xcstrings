            "value": "Eklentiler sayfasını açın ve Geliştirici modunu etkinleştirin"
          }
        }
      }
    },
    "Click the button below. On the page that opens, switch on “Developer mode” in the top right corner.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki düğmeye tıklayın. Açılan sayfada sağ üst köşedeki “Geliştirici modu”nu açın."
          }
        }
      }
    },
    "Open %@": {
