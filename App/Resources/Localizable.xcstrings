            "state": "translated",
            "value": "Oturum açıldığında başlat"
          }
        }
      }
    },
    "Start in the menu bar without opening the main window": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana pencereyi açmadan menü çubuğunda başla"
          }
        }
      }
    },
    "Hide the Dock icon while the main window is closed": {
      "localizations": {
        "tr": {
