    "Show Plugin Folder": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklenti Klasörünü Göster"
          }
        }
      }
    },
    "The extensions let your browsers hand their downloads to MC Download Manager and capture videos on pages. A guided setup walks you through each browser, one at a time. You can run it later from Settings ▸ Browser Extensions.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklentiler sayesinde tarayıcılarınız indirmelerini MC Download Manager'a aktarır ve sayfalardaki videolar yakalanır. Yönlendirmeli kurulum her tarayıcıyı tek tek ele alır. Bunu daha sonra Ayarlar ▸ Tarayıcı Eklentileri bölümünden de çalıştırabilirsiniz."
          }
        }
      }
    },
