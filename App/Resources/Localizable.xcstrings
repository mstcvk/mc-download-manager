            "state": "translated",
            "value": "Bu klasörü yerinde tutun; tarayıcı eklentiyi buradan yükler."
          }
        }
      }
    },
    "Open the extensions page and turn on Developer mode": {
      "localizations": {
        "tr": {
          "stringUnit": {
